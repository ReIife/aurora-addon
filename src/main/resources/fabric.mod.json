{
  "schemaVersion": 1,
  "id": "aurora",
  "version": "${version}",
  "name": "Aurora",
  "description": "Aurora addon for Evernight: elytra automation, production helpers and chat utilities ported from the Meteor Client addon of the same name.",
  "authors": [
    "n_lzy",
    "Aurora port contributors"
  ],
  "contact": {
    "homepage": "https://github.com/Evernight-Client/Evernight",
    "sources": "https://github.com/Evernight-Client/evernight-addon-template"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "evernight-addon": [
      "com.aurora.addon.Aurora"
    ]
  },
  "mixins": [
    "aurora.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/mc_biome-1.171.1.jar"
    },
    {
      "file": "META-INF/jars/mc_core-1.210.0.jar"
    },
    {
      "file": "META-INF/jars/mc_feature-1.171.11.jar"
    },
    {
      "file": "META-INF/jars/mc_math-1.171.0.jar"
    },
    {
      "file": "META-INF/jars/mc_noise-1.171.1.jar"
    },
    {
      "file": "META-INF/jars/mc_seed-1.171.1.jar"
    },
    {
      "file": "META-INF/jars/mc_terrain-1.171.1.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "evernight": ">=1.2.4"
  }
}
